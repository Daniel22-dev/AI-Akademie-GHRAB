{
  "name": "ai-akademie-ghrab",
  "version": "1.4.11",
  "private": true,
  "type": "module",
  "description": "Soukromý prezentační rozcestník AI Akademie GHRAB",
  "scripts": {
    "build:notes": "node scripts/build-speaker-notes.mjs",
    "build:exports": "node scripts/build-exports.mjs",
    "build": "npm run build:notes && npm run build:exports",
    "check": "node scripts/check.mjs",
    "test": "npm run build:exports && node scripts/check.mjs",
    "build:school-server": "npm run build && node scripts/build-school-server.mjs",
    "qa:secrets": "node scripts/qa-security-secrets.mjs",
    "qa:garp25:tooling": "node security/garp25/tools/selftest-garp251.mjs",
    "qa:garp25:sw": "node security/garp25/tools/check-sw-security-freeze.mjs dist-school-server/sw.js dist-school-server security/security-critical-assets.json",
    "qa:garp25:vendored": "node security/garp25/tools/check-vendored-consistency.mjs security/vendored-consistency.json",
    "qa:garp25:sbom": "node scripts/generate-cyclonedx-sbom.mjs",
    "qa:garp25:static": "npm run qa:garp25:tooling && npm run qa:garp25:pinned && npm run build:pages && npm run qa:secrets && npm run qa:garp25:deployment && npm run qa:garp25:sw-pages && npm run qa:garp25:vendored && npm run qa:garp25:sbom && npm run qa:safe-promotion",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "qa:garp25:pinned": "node scripts/qa-garp25-pinned-inputs.mjs",
    "qa:garp25:deployment": "node security/garp25/tools/scan-deployment-leaks.mjs dist-pages",
    "qa:garp25:sw-pages": "node security/garp25/tools/check-sw-security-freeze.mjs dist-pages/sw.js dist-pages security/security-critical-assets.json",
    "qa:safe-promotion": "node scripts/qa-safe-promotion.mjs",
    "qa:current-evidence": "node scripts/create-current-release-evidence.mjs dist-pages"
  },
  "engines": {
    "node": ">=18"
  }
}
